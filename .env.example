# ==========================================
# AVOMEDIDAS - CONFIGURACIÓN DE REDIS EN VERCEL
# ==========================================

# Opción 1: Vercel KV / Upstash Redis (Recomendado para Serverless vía REST)
# Si instalas la integración de Upstash en Vercel, estas variables se configuran automáticamente:
KV_REST_API_URL=https://tu-db-aqui.upstash.io
KV_REST_API_TOKEN=tu_token_aqui_upstash

# O usando los nombres de Upstash:
# UPSTASH_REDIS_REST_URL=https://tu-db-aqui.upstash.io
# UPSTASH_REDIS_REST_TOKEN=tu_token_aqui_upstash

# Opción 2: Redis Estándar (TCP / TLS con ioredis)
# REDIS_URL=rediss://default:tu_password@tu-host.upstash.io:6379

# Puerto local para servidor de desarrollo (opcional)
PORT=3000
